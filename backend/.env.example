# Proposed settings. Configuration loading is not implemented yet.
# Copy to .env later and replace every secret placeholder.
# Never commit the actual .env file.

APP_NAME=PocketWise
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

POSTGRES_DB=pocketwise
POSTGRES_USER=pocketwise
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# db is the planned Compose database service name.
# Use localhost if the backend runs directly on your computer.
DATABASE_URL=postgresql+psycopg://pocketwise:REPLACE_WITH_A_STRONG_PASSWORD@db:5432/pocketwise

JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=[]
